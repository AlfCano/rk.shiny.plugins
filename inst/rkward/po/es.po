# ==========================================================
# 1. Metadatos y Descripción
# ==========================================================
msgid "A collection of interactive Shiny interfaces for RKWard."
msgstr "Una colección de interfaces interactivas de Shiny para RKWard. Incluye: Interactive Pivot Table, Professional Pivot Table, Visual Explorer, ggplot GUI, Esquisse Plot Builder, Automated EDA Report, Quick EDA, Factoshiny, Shinystan Diagnostics y Shiny Item Analysis."

# ==========================================================
# 2. Menús y Jerarquía (Dejando Shiny sin traducir)
# ==========================================================
msgid "Shiny"
msgstr "Shiny"

msgid "Visualization"
msgstr "Visualización"

msgid "Exploration"
msgstr "Exploración"

msgid "Statistics"
msgstr "Estadística"

msgid "Psychometrics"
msgstr "Psicometría"

# ==========================================================
# 3. Nombres de los Plugins (Elementos del Menú)
# ==========================================================
msgid "Interactive Pivot Table"
msgstr "Tabla Dinámica Interactiva"

msgid "Professional Pivot Table"
msgstr "Tabla Dinámica Profesional"

msgid "Visual Explorer"
msgstr "Explorador Visual"

msgid "ggplot GUI"
msgstr "Interfaz ggplot (GUI)"

msgid "Esquisse Plot Builder"
msgstr "Constructor de Gráficos Esquisse"

msgid "Automated EDA Report"
msgstr "Reporte Automatizado de EDA"

msgid "Quick EDA"
msgstr "EDA Rápido"

msgid "Factoshiny"
msgstr "Factoshiny"

msgid "Shinystan Diagnostics"
msgstr "Diagnósticos Shinystan"

msgid "Shiny Item Analysis"
msgstr "Análisis de Ítems (Shiny Item Analysis)"

