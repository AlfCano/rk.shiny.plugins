# ==========================================================
msgid "Visual Explorer (GWalkR)"
msgstr "Explorador Visual (GWalkR)"

msgid "Interactive Plot Builder (ggplot)"
msgstr "Constructor de Gráficos Interactivo (ggplot)"

msgid "Esquisse (Tableau-style)"
msgstr "Esquisse (Estilo Tableau)"

