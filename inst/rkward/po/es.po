# 5. Etiquetas Específicas de las Tablas Dinámicas
# ==========================================================
msgid "Interactive Pivot Table (Shiny)"
msgstr "Tabla Dinámica Interactiva (Shiny)"

msgid "This will launch the Interactive Pivot Table in your external web browser for maximum stability."
msgstr "Esto iniciará la Tabla Dinámica Interactiva en tu navegador web externo para garantizar la máxima estabilidad."

msgid "Professional Table (Static)"
msgstr "Tabla Profesional (Estática)"

msgid "Rows (Categorical)"
msgstr "Filas (Categóricas)"

msgid "Columns (Categorical)"
msgstr "Columnas (Categóricas)"

msgid "Measure (Continuous/Numeric)"
msgstr "Medida (Continua/Numérica)"

msgid "Weight variable (Optional)"
msgstr "Variable de ponderación (Opcional)"

