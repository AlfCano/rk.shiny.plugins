# 7. Etiquetas de Exploración y Estadística
# ==========================================================
msgid "Automated Data Report"
msgstr "Reporte de Datos Automatizado"

msgid "Quick EDA"
msgstr "EDA Rápido"

msgid "Factoshiny (Multivariate)"
msgstr "Factoshiny (Multivariante)"

msgid "Data or PCA/CA Object"
msgstr "Datos u Objeto PCA/CA"

msgid "Fitted Model Object"
msgstr "Objeto de Modelo Ajustado"

# ==========================================================
# 8. Etiquetas de Psicometría
# ==========================================================
msgid "Click Submit to launch the ShinyItemAnalysis suite.\n(Data can be uploaded inside the app or selected from built-in examples)."
msgstr "Haz clic en Enviar para iniciar la suite de ShinyItemAnalysis.\n(Los datos pueden cargarse dentro de la app o seleccionarse de los ejemplos integrados)."
